# ---------------------------------------------------------------------------
# chatbot-llm-rag — variables de entorno
# Copiar como ".env" y completar. Sin claves la app arranca igual en modo demo:
# responde con las FAQs y el catálogo, y busca en los documentos con TF-IDF.
# Los datos del negocio (tienda, catálogo, FAQs, prompt, documentos) están en datos/.
# El archivo .env está en .gitignore: nunca se sube al repositorio.
# ---------------------------------------------------------------------------

# --- Aplicación --------------------------------------------------------------
# local | produccion | pruebas   (en produccion ADMIN_TOKEN es obligatorio)
ENTORNO=local

# Carpeta con los datos del negocio (tienda, catálogo, FAQs, prompt y documentos);
# una ruta relativa se toma desde la raíz del repositorio
CARPETA_DATOS=datos

# --- LLM principal (cualquier API compatible con OpenAI) -----------------------
# Qwen en Alibaba Cloud Model Studio, con una sola clave para el chat, el respaldo y
# los embeddings: la misma en LLM_API_KEY, LLM_2_API_KEY y EMBEDDINGS_API_KEY.
# La URL depende de la región de la cuenta (esta es la internacional, Singapur);
# revisarla en la consola de Model Studio.
# Otra opción compatible: DeepSeek (LLM_BASE_URL=https://api.deepseek.com y
# LLM_MODEL=deepseek-chat, con su propia clave).
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus

# --- LLM de respaldo (opcional; se usa si el principal falla) -----------------
# En la región internacional, qwen-turbo no está disponible: el respaldo es qwen-flash.
LLM_2_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_2_API_KEY=
LLM_2_MODEL=qwen-flash

# Parámetros de generación
LLM_TIMEOUT_S=60
LLM_TEMPERATURA=0.3
# Tope de tokens por respuesta: también limita el gasto por mensaje
LLM_MAX_TOKENS=700
# Campos extra para el cuerpo de la petición, en JSON (p. ej. {"enable_thinking": false})
# LLM_EXTRA_BODY={}
# Tope de tokens del chat en las últimas 24 horas; al pasarlo se responde en modo demo (0 = sin tope)
LLM_TOKENS_POR_DIA=2000000
# Precio del modelo en USD por millón de tokens, para estimar el costo en /api/metricas (0 = no se estima)
PRECIO_ENTRADA_USD_MILLON=0
PRECIO_SALIDA_USD_MILLON=0

# Reintentos ante 429, 5xx o cortes de red, en el chat y en los embeddings.
# Si el proveedor pide esperar (Retry-After) más que API_ESPERA_MAX_S, no se espera.
API_REINTENTOS=2
API_ESPERA_MAX_S=6

# --- Embeddings por API (RAG) ----------------------------------------------------
EMBEDDINGS_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-v4
# 0 = no enviar el parámetro y usar la dimensión por defecto del modelo
EMBEDDINGS_DIMENSIONES=1024
# Textos por llamada (text-embedding-v4 acepta hasta 10)
EMBEDDINGS_LOTE=10
# Segundos máximos por llamada de embeddings (un timeout se reintenta, a diferencia del chat)
EMBEDDINGS_TIMEOUT_S=30

# --- Clasificador de preguntas frecuentes -------------------------------------
FAQ_UMBRAL=0.55
FAQ_MARGEN=0.03
FAQ_CONTEXTO_MIN=0.25
# Similitud mínima para adjuntar una FAQ cercana al mensaje que ve el modelo
FAQ_PROMPT_MIN=0.5

# --- RAG ---------------------------------------------------------------------------
# Umbral de similitud con embeddings; calibrar con scripts/evaluar.py
RAG_UMBRAL=0.35
# Umbral cuando se usa TF-IDF (sin embeddings): su escala es más baja
RAG_UMBRAL_TFIDF=0.08
RAG_K_INICIAL=8
RAG_K_FINAL=3
# 1.0 = solo relevancia · 0.0 = solo variedad · 0.5 = equilibrio
RAG_MMR_LAMBDA=0.5
CHUNK_MAX_PALABRAS=150
CHUNK_OVERLAP_PALABRAS=25

# --- Recomendación de libros (híbrido: contenido + valoración) ----------------------
# Candidatos que se evalúan antes de ordenar
RECO_CANDIDATOS=20
# Similitud mínima con embeddings y con TF-IDF; calibrar con scripts/evaluar.py
RECO_UMBRAL=0.25
RECO_UMBRAL_TFIDF=0.03
# Peso del parecido con lo pedido y de la valoración en el puntaje final
RECO_PESO_SIMILITUD=0.75
RECO_PESO_VALORACION=0.25
# Votos a partir de los cuales una valoración pesa más que la media del catálogo
RECO_VOTOS_MINIMOS=20

# --- Conversación ------------------------------------------------------------------
# Mensajes del historial que ve el modelo; lo anterior le llega resumido
MAX_MENSAJES=8
MAX_VUELTAS=3
LIMITE_MENSAJE=2000
# Resumen encadenado de lo que sale de la ventana (en segundo plano; sus tokens cuentan para el tope)
RESUMEN_ACTIVO=true

# --- Protección del servicio publicado ---------------------------------------------
# Mensajes de chat por minuto por IP (0 = sin límite)
LIMITE_CHAT_POR_MINUTO=20
# Proxies delante de la app que agregan X-Forwarded-For (0 en local, 1 en Azure Container Apps)
PROXIES_CONFIABLES=0
# Protege /api/logs, /api/metricas, /api/sesion y /api/ventas.csv.
# Vacío en local = abiertos. Generar uno con: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
# Content-Security-Policy del frontend (ajustar si se agrega una fuente o librería externa)
# CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self'; ...

# Acceso de la demo: un usuario y el hash de su clave. Vacíos en local = sin login;
# en produccion son obligatorios. La clave nunca va en texto: generar la línea con
#   uv run python scripts/hash_clave.py
# y pegarla tal cual (entre comillas simples, para que Docker no toque los "$").
ACCESO_USUARIO=
ACCESO_CLAVE_HASH=
# Horas que dura una sesión e intentos de inicio de sesión por IP cada 15 minutos
ACCESO_HORAS_SESION=8
ACCESO_INTENTOS_POR_IP=5

# --- Logs --------------------------------------------------------------------------
# texto (legible en consola) | json (una línea JSON por evento, para Log Analytics)
LOG_FORMATO=texto
LOG_NIVEL=INFO
LOG_CONSOLA=true
LOG_ROTACION_MB=2
# Si una llamada al LLM tarda más que esto, se registra un aviso llm.lento
LLM_LENTO_MS=4000

# --- Rutas (relativas a la raíz del repositorio) -----------------------------------
# DB_PATH=var/tienda.db
# LOG_ARCHIVO=var/logs/eventos.jsonl
# CACHE_EMBEDDINGS=var/embeddings.npz
# CACHE_EMBEDDINGS_CATALOGO=var/embeddings_catalogo.npz
